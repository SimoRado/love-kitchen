datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String    @id @default(cuid())
  name         String
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  price           Float
  image           String?
  available       Boolean                @default(true)
  prepTimeMinutes Int                    @default(15)
  prepStation     String?                @default("KITCHEN")
  categoryId      String
  category        Category               @relation(fields: [categoryId], references: [id])
  modifierGroups  ProductModifierGroup[]
  orderItems      OrderItem[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ProductModifierGroup {
  id            String                  @id @default(cuid())
  productId     String
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  required      Boolean                 @default(false)
  minSelections Int                     @default(0)
  maxSelections Int                     @default(1)
  displayOrder  Int                     @default(0)
  active        Boolean                 @default(true)
  options       ProductModifierOption[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model ProductModifierOption {
  id              String               @id @default(cuid())
  modifierGroupId String
  modifierGroup   ProductModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDelta      Float                @default(0)
  active          Boolean              @default(true)
  displayOrder    Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  idempotencyKey       String?     @unique
  customerName         String
  customerPhone        String
  customerAddress      String?
  orderType            String      @default("DELIVERY") // DELIVERY | PICKUP
  status               String      @default("PENDING")  // PENDING | CONFIRMED | PREPARING | READY | COMPLETED | CANCELLED
  subtotal             Float
  deliveryFee          Float       @default(0)
  total                Float
  allergies            String?
  notes                String?
  estimatedPrepMinutes Int?
  estimatedReadyAt     DateTime?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Device {
  id             String   @id @default(cuid())
  publicId       String   @unique
  name           String
  type           String   @default("POS") // POS | KITCHEN | ADMIN
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE | DISABLED | REVOKED
  restaurantId   String   @default("default")
  credentialHash String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  registrationCodes DeviceRegistrationCode[]

  @@index([restaurantId, type, status])
  @@index([status])
}

model DeviceRegistrationCode {
  id              String   @id @default(cuid())
  codeHash        String   @unique
  deviceName      String
  deviceType      String   @default("POS")
  restaurantId    String   @default("default")
  replaceDeviceId String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  replaceDevice Device? @relation(fields: [replaceDeviceId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([replaceDeviceId])
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String
  price               Float               // Base product price at time of ordering
  configuredUnitPrice Float?              // Final unit price (base price + sum of modifier priceDeltas)
  quantity            Int                 @default(1)
  modifiers           OrderItemModifier[]
}

model OrderItemModifier {
  id                 String    @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroupName  String
  modifierOptionName String
  priceDelta         Float     @default(0)
  createdAt          DateTime  @default(now())
}

model RestaurantSettings {
  id                         String        @id @default("default")
  name                       String        @default("Dark Kitchen")
  subtitle                   String?       @default("Artisanal Kitchen & Delivery")
  phone                      String        @default("+212 522 123456")
  address                    String        @default("N° 6, quartier les princesses, Résidence Miradore A, Rue Al Jounaid Arsat Lakbir, Casablanca")
  googleMapsUrl              String?
  whatsappNumber             String?
  currency                   String        @default("MAD")
  deliveryFee                Float         @default(15)
  isOpenOverride             Boolean?      // null = schedule-based, true = force open, false = force closed
  isAutoHours                Boolean       @default(true)
  congestionBufferMinutes    Int           @default(5)
  maxCongestionBufferMinutes Int           @default(20)
  openingHours               OpeningHour[]
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
}

model OpeningHour {
  id         String             @id @default(cuid())
  dayOfWeek  Int                // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName    String             // Monday, Tuesday, etc.
  openTime   String             @default("09:00")
  closeTime  String             @default("23:00")
  isClosed   Boolean            @default(false)
  settingsId String             @default("default")
  settings   RestaurantSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}
