# Database Connection (Hosted PostgreSQL e.g. Prisma Postgres, Neon, Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin Authentication
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Vercel Blob Storage. The installed SDK also supports Vercel OIDC with
# BLOB_STORE_ID/VERCEL_OIDC_TOKEN when those are supplied by the integration.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
